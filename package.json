{
  "name": "morningtv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --ignore-version-mismatches",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "sync": "cargo run --release --manifest-path crates/sentinel/Cargo.toml",
    "sync:node": "node scripts/sync_and_heal.mjs",
    "sentinel:rust": "cargo run --release --manifest-path crates/sentinel/Cargo.toml",
    "dist": "node scripts/build-installer.js",
    "release": "node scripts/one-click-release.js --publish",
    "signer:gen": "tauri signer generate -w scripts/morningtv.key",
    "test:frontend": "node --experimental-strip-types tests/frontend.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:frontend && npm run test:rust",
    "ci": "npm run lint && npm run test && npm run build && npm run cargo:check",
    "lint": "eslint src && biome check src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.37.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
