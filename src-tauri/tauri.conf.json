{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MorningTV",
  "version": "1.0.0",
  "identifier": "com.morningstar.morningtv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MorningTV Native Windows Live TV Player",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: asset: tauri:; media-src 'self' blob: http://127.0.0.1:* https:; connect-src 'self' http://127.0.0.1:* https: ipc: tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "licenseFile": "../assets/LICENSE.txt",
    "category": "Entertainment",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "../assets/morningtv-installer.nsi",
        "installerHooks": "../assets/installer-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNEY5MEQ1QkMyMTA1QkQKUldTOUJTRzgxWkJQa015VzRKMG9xQldVRTRGL3BpaVQzYStIT0YxRkhuREYyd3QwUDRTVDFnNHAK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/morningstarwebd/morningtv/releases/latest/download/latest.json"
      ]
    }
  }
}
