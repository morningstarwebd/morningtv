{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MorningTV",
  "version": "1.0.1",
  "identifier": "com.morningstar.morningtv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MorningTV - Native Windows Live TV Player",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "licenseFile": "../assets/LICENSE.txt",
    "category": "Entertainment",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "../assets/morningtv-installer.nsi",
        "installerHooks": "../assets/installer-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4QkJGQjRDOTM3MDYzMjYKUldRbVkzQ1RUUHU3R1BlRk5JMy8rMEtxVVhCT2R0c3BySVpDZVlteXJ0bXJuSUxnN2lHV0JBNkMK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/morningstarwebd/morningtv/releases/latest/download/latest.json"
      ]
    }
  }
}
